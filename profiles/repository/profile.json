{
  "schema_version": 1,
  "name": "repository",
  "description": "Repository context with Tasks and durable decisions.",
  "features": [
    "tasks",
    "decisions"
  ],
  "optional_features": [
    "checkpoints",
    "memory"
  ],
  "required_paths": [
    "PROJECT.md",
    "AGENTS.md",
    ".hermes/context-kit.json",
    ".hermes/state.md",
    ".hermes/context-index.md",
    "tasks/README.md",
    "tasks/current.md",
    "docs/decisions/README.md"
  ]
}
