{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/boykaspaces/hermes-context-kit/schemas/context-kit-adoption.schema.json",
  "title": "Context Kit adoption manifest v2",
  "type": "object",
  "required": [
    "schema_version",
    "spec_version",
    "kit_version",
    "profile",
    "features",
    "runtime_adapters",
    "workflow_adapter"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "spec_version": {
      "const": 2
    },
    "kit_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "profile": {
      "enum": [
        "minimal",
        "repository",
        "multi-repo"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "enum": [
          "tasks",
          "decisions",
          "checkpoints",
          "memory",
          "multi-repo"
        ]
      },
      "uniqueItems": true
    },
    "runtime_adapters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "version": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "workflow_adapter": {
      "oneOf": [
        {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
            "version": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
