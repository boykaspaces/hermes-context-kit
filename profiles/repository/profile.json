{
  "schema_version": 2,
  "name": "repository",
  "description": "Repository context with Tasks and durable decisions.",
  "features": [
    "tasks",
    "decisions"
  ],
  "optional_features": [
    "checkpoints",
    "memory"
  ],
  "required_artifacts": [
    "project",
    "manifest",
    "state",
    "context-index",
    "task-index",
    "current-task",
    "decision-index"
  ]
}
