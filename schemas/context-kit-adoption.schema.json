{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/boykaspaces/hermes-context-kit/schemas/context-kit-adoption.schema.json",
  "title": "Hermes Context Kit adoption manifest",
  "type": "object",
  "required": [
    "schema_version",
    "spec_version",
    "kit_version",
    "profile",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "spec_version": {
      "const": 1
    },
    "kit_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "profile": {
      "enum": [
        "minimal",
        "repository",
        "multi-repo"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "enum": [
          "tasks",
          "decisions",
          "checkpoints",
          "memory",
          "multi-repo"
        ]
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
