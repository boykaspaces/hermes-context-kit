{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/boykaspaces/hermes-context-kit/schemas/component-lock.schema.json",
  "title": "Context Kit component lock",
  "type": "object",
  "required": [
    "schema_version",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "repository_url",
          "source_revision"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "repository_url": {
            "type": "string",
            "pattern": "^https?://[^\\s]+$"
          },
          "source_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "extensions": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
